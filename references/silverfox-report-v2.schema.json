{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "silverfox-report/v2",
  "title": "SilverFox intelligent analysis report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "threat_level",
    "summary",
    "team_summary",
    "current_stage",
    "progress",
    "stage_details",
    "browser_analysis",
    "last_activity_analysis",
    "persistence_analysis",
    "process_analysis",
    "network_analysis",
    "virus_analysis",
    "memory_analysis",
    "key_findings",
    "recommendations",
    "post_run_review"
  ],
  "properties": {
    "schema_version": { "const": "silverfox-report/v2" },
    "threat_level": { "type": "string", "enum": ["safe", "low", "medium", "high", "critical"] },
    "summary": { "type": "string", "minLength": 1 },
    "team_summary": { "type": "string", "minLength": 1 },
    "current_stage": { "const": "完成" },
    "progress": { "const": 100 },
    "stage_details": { "type": "string", "minLength": 1 },
    "browser_analysis": { "$ref": "#/$defs/analysisModule" },
    "last_activity_analysis": { "$ref": "#/$defs/analysisModule" },
    "persistence_analysis": { "$ref": "#/$defs/analysisModule" },
    "process_analysis": { "$ref": "#/$defs/analysisModule" },
    "network_analysis": { "$ref": "#/$defs/analysisModule" },
    "virus_analysis": { "$ref": "#/$defs/analysisModule" },
    "memory_analysis": { "$ref": "#/$defs/analysisModule" },
    "key_findings": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1 } },
    "recommendations": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1 } },
    "post_run_review": { "$ref": "#/$defs/postRunReview" }
  },
  "$defs": {
    "analysisModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings", "evidence", "assessment", "metrics", "details"],
      "properties": {
        "summary": { "type": "string" },
        "findings": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1 } },
        "assessment": { "type": "string" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "details": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/detailItem" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_analyzed", "suspicious_count", "high_risk_count", "displayed_count", "truncated"],
      "properties": {
        "total_analyzed": { "type": "integer", "minimum": 0 },
        "suspicious_count": { "type": "integer", "minimum": 0 },
        "high_risk_count": { "type": "integer", "minimum": 0 },
        "displayed_count": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    },
    "detailItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "risk_level", "object_type", "title", "timestamp", "attributes", "reasons", "recommendation", "evidence_refs"],
      "properties": {
        "object_id": { "type": "string", "minLength": 1 },
        "risk_level": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "object_type": {
          "type": "string",
          "enum": ["browser_history", "browser_download", "last_activity", "persistence", "process", "network_connection", "dns_query", "dns_threat", "memory_hit", "virus_file"]
        },
        "title": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string" },
        "attributes": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/detailAttribute" } },
        "reasons": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1 } },
        "recommendation": { "type": "string" },
        "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "detailAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "postRunReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "confidence", "included_signals", "noise_reasons", "gaps", "next_steps"],
      "properties": {
        "coverage": { "type": "string" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "included_signals": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
        "noise_reasons": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
        "gaps": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
        "next_steps": { "type": "array", "maxItems": 30, "items": { "type": "string" } }
      }
    }
  }
}
